<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">UPDATES</p><h1>Notifications</h1><p class="muted">Important changes for complaints you are involved in.</p></div><form action="/notifications/read-all" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Mark all as read</button></form></div>
<section class="panel"><% if (!notifications.length) { %><div class="empty-state"><span>♧</span><h3>You're all caught up</h3><p>There are no notifications to show.</p></div><% } else { %><div class="notification-list"><% notifications.forEach((notification) => { %><article class="notification-item <%= notification.isRead ? 'read' : 'unread' %>"><span class="notification-dot"></span><div class="notification-body"><strong><%= notification.title %></strong><p><%= notification.message %></p><small><%= notification.createdAt.toLocaleString() %><% if (notification.complaint) { %> · <a href="/complaints/<%= notification.complaint._id %>"><%= notification.complaint.title %></a><% } %></small></div><% if (!notification.isRead) { %><form action="/notifications/<%= notification._id %>/read" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link" type="submit">Mark read</button></form><% } %></article><% }); %></div><% } %></section>
<%- include('../partials/bottom') %>
