<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Audit log</h1><p class="muted">Administrative actions are recorded for accountability.</p></div></div>
<section class="panel"><% if (!logs.length) { %><div class="empty-state"><span>☷</span><h3>No audit events</h3><p>Administrative changes will appear here.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Record</th><th>Details</th></tr></thead><tbody><% logs.forEach((log) => { %><tr><td><%= log.createdAt.toLocaleString() %></td><td><%= log.actor ? `${log.actor.name} (${log.actor.role.toLowerCase()})` : 'System' %></td><td><strong><%= log.action.replaceAll('_',' ').toLowerCase() %></strong></td><td><%= log.entityType %><% if (log.entityId) { %><small><%= log.entityId %></small><% } %></td><td><%= Object.entries(log.details || {}).map(([key, value]) => `${key}: ${value}`).join(' · ') %></td></tr><% }); %></tbody></table></div><% } %></section>
<%- include('../partials/bottom') %>
