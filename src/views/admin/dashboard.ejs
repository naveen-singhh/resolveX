<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">ORGANIZATION OVERVIEW</p><h1>Service operations</h1><p class="muted">Monitor workload, response, and resolution across the organization.</p></div><a class="button primary" href="/admin/complaints">Manage complaints →</a></div>
<section class="stat-grid five">
  <article class="stat-card"><span class="stat-icon blue">▤</span><span class="stat-label">Total complaints</span><strong><%= stats.total %></strong><small>All recorded requests</small></article>
  <article class="stat-card"><span class="stat-icon amber">◷</span><span class="stat-label">Open</span><strong><%= stats.open %></strong><small>Awaiting completion</small></article>
  <article class="stat-card"><span class="stat-icon purple">↻</span><span class="stat-label">In progress</span><strong><%= stats.inProgress %></strong><small>Being worked on</small></article>
  <article class="stat-card"><span class="stat-icon green">✓</span><span class="stat-label">Resolved</span><strong><%= stats.resolved %></strong><small>Resolved or closed</small></article>
  <article class="stat-card"><span class="stat-icon red">!</span><span class="stat-label">Overdue</span><strong><%= stats.overdue %></strong><small>Past resolution target</small></article>
</section>
<div class="admin-insights">
  <section class="panel"><div class="panel-heading"><div><h2>Complaints by category</h2><p>Share of all recorded service requests</p></div></div>
  <% if (!categories.length) { %><p class="muted">Category totals will appear when requests are submitted.</p><% } else { const max = Math.max(...categories.map((item) => item.count)); %><div class="bar-list"><% categories.forEach((item) => { %><div class="bar-row"><div><span><%= item._id %></span><strong><%= item.count %></strong></div><div class="bar-track"><span style="width:<%= Math.max(6, Math.round(item.count / max * 100)) %>%"></span></div></div><% }); %></div><% } %></section>
  <section class="panel"><div class="panel-heading"><div><h2>Priority distribution</h2><p>Current workload across priorities</p></div></div><div class="priority-summary"><% ['CRITICAL','HIGH','MEDIUM','LOW'].forEach((priority) => { const item = priorities.find((entry) => entry._id === priority); %><div><span class="priority priority-<%= priority.toLowerCase() %>"><%= priority %></span><strong><%= item ? item.count : 0 %></strong></div><% }); %></div><a class="text-link panel-link" href="/admin/sla-policies">Manage SLA policies →</a></section>
</div>
<section class="panel"><div class="panel-heading"><div><h2>Recent complaints</h2><p>Latest requests across the organization</p></div><a class="text-link" href="/admin/complaints">View all →</a></div>
  <% if (!complaints.length) { %><div class="empty-state"><span>▤</span><h3>No complaints submitted</h3><p>Requests will appear here once students create them.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Complaint</th><th>Student</th><th>Category</th><th>Priority</th><th>Assigned to</th><th>Status</th></tr></thead><tbody><% complaints.forEach((item) => { %><tr><td><a class="row-title" href="/complaints/<%= item._id %>"><%= item.title %></a><small><%= item.createdAt.toLocaleDateString() %></small></td><td><%= item.createdBy.name %></td><td><%= item.category %></td><td><span class="priority priority-<%= item.priority.toLowerCase() %>"><%= item.priority %></span></td><td><%= item.assignedTo ? item.assignedTo.name : 'Unassigned' %></td><td><%- include('../partials/status', { status: item.status }) %></td></tr><% }); %></tbody></table></div><% } %>
</section>
<%- include('../partials/bottom') %>
