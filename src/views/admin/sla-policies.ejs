<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">SERVICE LEVELS</p><h1>SLA policies</h1><p class="muted">Targets use calendar time and apply when a complaint is created or reprioritized.</p></div></div>
<section class="policy-grid"><% policies.forEach((policy) => { %><article class="panel policy-card"><div class="policy-head"><span class="priority priority-<%= policy.priority.toLowerCase() %>"><%= policy.priority %></span><span class="policy-state <%= policy.isActive ? 'enabled' : 'disabled' %>"><%= policy.isActive ? 'Active' : 'Inactive' %></span></div><form method="post" action="/admin/sla-policies/<%= policy.priority %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Response target <small>minutes</small><input type="number" name="responseMinutes" min="1" max="525600" value="<%= policy.responseMinutes %>" required></label><label>Resolution target <small>minutes</small><input type="number" name="resolutionMinutes" min="1" max="525600" value="<%= policy.resolutionMinutes %>" required></label><label class="checkbox-label"><input type="checkbox" name="isActive" value="true" <%= policy.isActive ? 'checked' : '' %>> Policy active</label><button class="button secondary full" type="submit">Save policy</button></form></article><% }); %></section>
<%- include('../partials/bottom') %>
