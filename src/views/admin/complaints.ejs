<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>All complaints</h1><p class="muted">Review organization-wide requests and update ownership.</p></div></div>
<section class="panel"><% if (!complaints.length) { %><div class="empty-state"><span>▤</span><h3>No complaints submitted</h3><p>New requests appear here automatically.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Request</th><th>Student</th><th>Priority</th><th>Technician</th><th>Status</th><th>Assign</th></tr></thead><tbody><% complaints.forEach((item) => { %><tr><td><a class="row-title" href="/complaints/<%= item._id %>"><%= item.title %></a><small><%= item.category %> · <%= item.location %></small></td><td><%= item.createdBy.name %></td><td><span class="priority priority-<%= item.priority.toLowerCase() %>"><%= item.priority %></span></td><td><%= item.assignedTo ? item.assignedTo.name : 'Unassigned' %></td><td><%- include('../partials/status', { status: item.status }) %></td><td><form action="/admin/complaints/<%= item._id %>/assign" method="post" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="technicianId" aria-label="Assign technician for <%= item.title %>" required><option value="">Assign…</option><option value="recommend">Recommend</option><% technicians.forEach((tech) => { %><option value="<%= tech._id %>" <%= item.assignedTo && String(item.assignedTo._id) === String(tech._id) ? 'selected' : '' %>><%= tech.name %></option><% }); %></select><button class="button secondary tiny" type="submit">Save</button></form></td></tr><% }); %></tbody></table></div><% } %></section>
<%- include('../partials/bottom') %>
