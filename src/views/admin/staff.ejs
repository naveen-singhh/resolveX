<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Staff management</h1><p class="muted">Create staff accounts and manage technician availability.</p></div></div>
<section class="panel"><div class="panel-heading"><div><h2>Add staff member</h2><p>Only admins can create privileged accounts.</p></div></div>
  <% if (errors && errors.length) { %><div class="form-errors"><% errors.forEach((error) => { %><p><%= error %></p><% }); %></div><% } %>
  <form action="/admin/staff" method="post" class="form-grid staff-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" required minlength="2" maxlength="80"></label><label>Email<input type="email" name="email" required maxlength="254"></label><label>Temporary password<input type="password" name="password" required minlength="10" maxlength="128"></label><label>Role<select name="role"><option value="TECHNICIAN">Technician</option><option value="ADMIN">Admin</option></select></label><label class="category-label">Technician categories <small>Leave empty to allow every category</small><select name="supportedCategories" multiple size="3"><% ['AMENITIES','WATER','ELECTRICAL','CLEANING','SECURITY','IT','OTHER'].forEach((category) => { %><option value="<%= category %>"><%= category %></option><% }); %></select></label><div class="form-end"><button class="button primary" type="submit">Create staff account</button></div></form>
</section>
<section class="panel"><div class="panel-heading"><div><h2>Current staff</h2><p>Inactive technicians cannot receive recommendations.</p></div></div>
  <% if (!users.length) { %><p class="muted">No staff accounts have been created.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Name</th><th>Role</th><th>Categories</th><th>Availability</th><th>Account</th><th>Update</th></tr></thead><tbody><% users.forEach((user) => { %><tr><td><strong><%= user.name %></strong><small><%= user.email %></small></td><td><%= user.role %></td><td><%= user.supportedCategories.length ? user.supportedCategories.join(', ') : 'All categories' %></td><td><%= user.isAvailable ? 'Available' : 'Unavailable' %></td><td><%= user.isActive ? 'Active' : 'Inactive' %></td><td><form method="post" action="/admin/staff/<%= user._id %>" class="staff-update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="isActive" aria-label="Account state"><option value="true" <%= user.isActive ? 'selected' : '' %>>Active</option><option value="false" <%= !user.isActive ? 'selected' : '' %>>Inactive</option></select><% if (user.role === 'TECHNICIAN') { %><select name="isAvailable" aria-label="Technician availability"><option value="true" <%= user.isAvailable ? 'selected' : '' %>>Available</option><option value="false" <%= !user.isAvailable ? 'selected' : '' %>>Unavailable</option></select><% } %><input type="password" name="password" minlength="10" maxlength="128" placeholder="New password (optional)" aria-label="Replacement password"><button class="button secondary tiny" type="submit">Update</button></form></td></tr><% }); %></tbody></table></div><% } %>
</section>
<%- include('../partials/bottom') %>
