<%- include('../partials/top', { title }) %>
<div class="page-heading"><div><p class="eyebrow">COMPLAINT #<%= complaint._id.toString().slice(-7).toUpperCase() %></p><h1><%= complaint.title %></h1><p class="muted"><%= complaint.category %> · <%= complaint.location %> · Submitted <%= complaint.createdAt.toLocaleString() %></p></div><div class="heading-badges"><%- include('../partials/status', { status: complaint.status }) %><span class="priority priority-<%= complaint.priority.toLowerCase() %>"><%= complaint.priority %> priority</span></div></div>
<div class="detail-grid">
  <div class="detail-main">
    <section class="panel"><div class="panel-heading"><div><h2>Request details</h2><p>Submitted by <%= complaint.createdBy.name %></p></div></div><p class="long-copy"><%= complaint.description %></p>
      <% if (complaint.resolutionSummary) { %><div class="resolution-box"><strong>Resolution summary</strong><p><%= complaint.resolutionSummary %></p></div><% } %>
      <% if (currentUser.role === 'STUDENT' && complaint.status === 'RESOLVED') { %><div class="button-row"><form method="post" action="/complaints/<%= complaint._id %>/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary" type="submit">Confirm resolution</button></form><form method="post" action="/complaints/<%= complaint._id %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Request reopening</button></form></div><% } else if (currentUser.role === 'STUDENT' && complaint.status === 'CLOSED') { %><form method="post" action="/complaints/<%= complaint._id %>/reopen"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button secondary" type="submit">Request reopening</button></form><% } %>
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Updates</h2><p>Notes and comments from people working on this request</p></div></div>
      <div class="comment-list"><% if (!comments.length) { %><p class="muted">No updates yet.</p><% } %><% comments.forEach((item) => { %><article class="comment"><div class="comment-head"><strong><%= item.author.name %></strong><span><%= item.author.role.toLowerCase() %> · <%= item.createdAt.toLocaleString() %></span></div><p><%= item.message %></p></article><% }); %></div>
      <% if (!['CLOSED','CANCELLED'].includes(complaint.status)) { %><form class="comment-form" action="<%= currentUser.role === 'TECHNICIAN' ? `/technician/complaints/${complaint._id}/comments` : `/complaints/${complaint._id}/comments` %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="message">Add an update</label><textarea id="message" name="message" rows="3" minlength="2" maxlength="2000" required placeholder="Share useful context or progress"></textarea><button class="button primary small" type="submit">Post update</button></form><% } %>
    </section>
    <section class="panel"><div class="panel-heading"><div><h2>Complaint history</h2><p>Recorded changes and actions</p></div></div><ol class="timeline"><% history.forEach((event) => { %><li><span class="timeline-dot"></span><div><strong><%= event.eventType.replaceAll('_', ' ').toLowerCase() %></strong><% if (event.actor) { %><span class="timeline-actor">by <%= event.actor.name %></span><% } else { %><span class="timeline-actor">system</span><% } %><% if (event.note) { %><p><%= event.note %></p><% } %><small><%= event.createdAt.toLocaleString() %></small></div></li><% }); %></ol></section>
  </div>
  <aside class="detail-aside">
    <section class="panel"><h2>Service details</h2><dl class="detail-list"><dt>Created by</dt><dd><%= complaint.createdBy.name %></dd><dt>Assigned technician</dt><dd><%= complaint.assignedTo ? complaint.assignedTo.name : 'Not assigned' %></dd><dt>Response deadline</dt><dd><%= complaint.responseDeadlineAt.toLocaleString() %></dd><dt>Resolution deadline</dt><dd><%= complaint.resolutionDeadlineAt.toLocaleString() %></dd></dl>
    <% if (currentUser.role === 'ADMIN') { %><hr><form method="post" action="/admin/complaints/<%= complaint._id %>/assign" class="form-stack compact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Assign technician<select name="technicianId" required><option value="">Choose technician</option><option value="recommend">Recommend by availability and workload</option><% technicians.forEach((tech) => { %><option value="<%= tech._id %>" <%= complaint.assignedTo && String(complaint.assignedTo._id) === String(tech._id) ? 'selected' : '' %>><%= tech.name %><%= tech.isAvailable ? '' : ' (unavailable)' %></option><% }); %></select></label><button class="button secondary small" type="submit">Save assignment</button></form>
    <form method="post" action="/admin/complaints/<%= complaint._id %>/priority" class="form-stack compact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Official priority<select name="priority"><% ['LOW','MEDIUM','HIGH','CRITICAL'].forEach((priority) => { %><option <%= complaint.priority === priority ? 'selected' : '' %> value="<%= priority %>"><%= priority %></option><% }); %></select></label><button class="button secondary small" type="submit">Update priority</button></form>
    <% if (!['CLOSED','CANCELLED'].includes(complaint.status)) { %><form method="post" action="/admin/complaints/<%= complaint._id %>/cancel" data-confirm="Cancel this complaint?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button danger-outline small" type="submit">Cancel complaint</button></form><% } %><% } %>
    <% if (currentUser.role === 'TECHNICIAN' && String(complaint.assignedTo._id) === String(currentUser._id)) { %><hr><% if (complaint.status === 'ASSIGNED' || complaint.status === 'REOPENED') { %><form method="post" action="/technician/complaints/<%= complaint._id %>/start"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button primary full" type="submit">Start work</button></form><% } %><% if (complaint.status === 'IN_PROGRESS') { %><form method="post" action="/technician/complaints/<%= complaint._id %>/resolve" class="form-stack compact"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Resolution summary<textarea name="resolutionSummary" rows="4" minlength="5" maxlength="2000" required></textarea></label><button class="button primary full" type="submit">Mark resolved</button></form><% } %><% } %>
    </section>
  </aside>
</div>
<%- include('../partials/bottom') %>
